# Database
# Docker Compose Postgres (host port 5433 so it does not fight local Postgres on 5432)
DATABASE_URL=postgresql://vacation:vacation@localhost:5433/vacation_planner
# SQLite (no Docker required)
# DATABASE_URL=sqlite:///./vacation_planner.db

SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
DATABASE_POOL_SIZE=10

# Claude (itinerary generation)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_MAX_RETRIES=2

# Embeddings (used only by RAG)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536

# Vector store
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=travel_knowledge
QDRANT_TIMEOUT=10

# RAG
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
