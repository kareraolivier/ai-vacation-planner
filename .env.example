# Database
# Docker Compose Postgres (host port 5433 so it does not fight local Postgres on 5432)
DATABASE_URL=postgresql://vacation:vacation@localhost:5433/vacation_planner
# SQLite (no Docker required)
# DATABASE_URL=sqlite:///./vacation_planner.db

SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
DATABASE_POOL_SIZE=10

# Claude (existing itinerary generator + agent tool-calling)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_MAX_RETRIES=2

# Embeddings (used only by RAG)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536

# Vector store
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=travel_knowledge
QDRANT_TIMEOUT=10

# RAG
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
AGENT_MAX_TOOL_ITERATIONS=6

# Weather (Open-Meteo by default; no API key required)
WEATHER_PROVIDER=openmeteo
WEATHER_API_URL=https://api.open-meteo.com/v1
WEATHER_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1
WEATHER_API_KEY=
WEATHER_TIMEOUT=10

# Maps (Nominatim / OpenStreetMap by default)
MAPS_PROVIDER=nominatim
MAPS_API_URL=https://nominatim.openstreetmap.org
MAPS_API_KEY=
MAPS_USER_AGENT=ai-vacation-planner/1.0
MAPS_TIMEOUT=10

# Pricing (optional live HTTP provider)
PRICING_PROVIDER=http
PRICING_API_URL=
PRICING_API_KEY=
PRICING_TIMEOUT=10

# Shared OpenAI key (STT/TTS/embeddings can reuse this)
OPENAI_API_KEY=

# Speech-to-text (openai or fake)
STT_PROVIDER=openai
STT_API_KEY=
STT_MODEL=whisper-1
STT_TIMEOUT=30
STT_MAX_BYTES=10485760
STT_ALLOWED_FORMATS=mp3,wav,m4a,webm,ogg,flac,mpeg,mp4

# Text-to-speech (openai or fake)
TTS_PROVIDER=openai
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_TIMEOUT=30

# Image understanding (anthropic or fake)
VISION_PROVIDER=anthropic
VISION_API_KEY=
VISION_MODEL=claude-haiku-4-5
VISION_TIMEOUT=30
VISION_MAX_BYTES=5242880
VISION_ALLOWED_FORMATS=jpeg,jpg,png,gif,webp

# MCP travel tools
MCP_ENABLED=true
MCP_TRANSPORT=inprocess
MCP_TIMEOUT=15
MCP_SERVER_COMMAND=
