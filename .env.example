# Database
DATABASE_URL=sqlite:///./vacation_planner.db
# DATABASE_URL=postgresql://username:password@localhost:5432/vacation_planner

SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
DATABASE_POOL_SIZE=10

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=2

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536

# Vector store
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=travel_knowledge
QDRANT_TIMEOUT=10

# RAG
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
AGENT_MAX_TOOL_ITERATIONS=6

# Weather (Open-Meteo by default; no API key required)
WEATHER_PROVIDER=openmeteo
WEATHER_API_URL=https://api.open-meteo.com/v1
WEATHER_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1
WEATHER_API_KEY=
WEATHER_TIMEOUT=10

# Maps (Nominatim / OpenStreetMap by default)
MAPS_PROVIDER=nominatim
MAPS_API_URL=https://nominatim.openstreetmap.org
MAPS_API_KEY=
MAPS_USER_AGENT=ai-vacation-planner/1.0
MAPS_TIMEOUT=10

# Pricing (optional live HTTP provider)
PRICING_PROVIDER=http
PRICING_API_URL=
PRICING_API_KEY=
PRICING_TIMEOUT=10
